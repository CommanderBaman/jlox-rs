fun add(x,y) {
    return x + y;
}
var c = 0;
var c = add(1,2);
print "add(1,2) = 3";
print c == 3;
print c;

{
    var a = "inner";
    {
        fun showA() {
            return a;
        }
        print "closure reference check";
        print showA();
        print "inner" == showA();
        var a = "block";
        print "closure with resolver reference check";
        print "inner" == showA();
        a = a + "need to use it";
    }
}

fun fib(n) {
    if (n <= 1) {
        return n;
    }
    return fib(n-1) + fib(n-2);
}

print "fib is recursive function";
print "fib(0) == 0";
print fib(0) == 0;

print "fib(1) == 1";
print fib(1) == 1;

print "fib(2) == 1";
print fib(2) == 1;

print "fib(3) == 2";
print fib(3) == 2;

print "fib(4) == 3";
print fib(4) == 3;

print "fib(5) == 5";
print fib(5) == 5;

print "fib(6) == 8";
print fib(6) == 8;

fun outer() {
    var a = "hello";
    fun inner() {
        var b = a;
        a = a + "2";
        return b;
    }
    return inner;
}

var x = outer();
print "closure 3 - first returns base";
print x() == "hello";
print "closure 3 - second modifies first";
print x() == "hello2";
print "closure 3 - third modifies second";
print x() == "hello22";



print "";
print "-------------";
print " Class Tests ";
print "-------------";


class Food {
    eat() {
        return "Swallow!";
    }
}

var f = Food();
print "can access class method";
print f.eat() == "Swallow!";

print "chaining of classes is allowed";
print Food().eat() == "Swallow!";


f.name = "tomato";
print "can access stored variables";
print f.name == "tomato";

class Thing {
  getCallback() {
    fun localFunction() {
      return this;
    }
    return localFunction;
  }
}

var t = Thing();
var callback = t.getCallback();
t.x = "value";

print "binding of this in class closures";
print callback().x == "value";


