print " For Tests ";
print "------------";

var a = 0;
print "a initialized to 0";
print a == 0;
for (var b = 0; b < 4; b = b + 1) {
    a = a + b;
}
// incremented to 6 because of sum of 0 + 1 + 2 + 3
print "a incremented to 6 in for";
print a == 6;

