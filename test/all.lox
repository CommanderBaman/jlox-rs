var a = "global a";
var b = "global b";
var c = "global c";
{
    var a = "outer a"; 
    var b = "outer b";
    {
        var a = "inner a";
        print "a == 'inner a'";
        print a == "inner a";
        print "b == 'outer b'";
        print b == "outer b";
        print "c == 'global c'";
        print c == "global c";
    }
    print "a == 'outer a'";
    print a == "outer a";
    print "b == 'outer b'";
    print b == "outer b";
    print "c == 'global c'";
    print c == "global c";
}
print "a == 'global a'";
print a == "global a";
print "b == 'global b'";
print b == "global b";
print "c == 'global c'";
print c == "global c";


