class Person {
  getName() {
    return this.name;
  }
}

var jane = Person();
jane.name = "Jane";

var bill = Person();
bill.name = "Bill";

var method = jane.getName;
print "method = jane.getName =>  method() = 'Jane'";
print method() == "Jane"; // ?

bill.getName = jane.getName;
print "bill.getName = jane.getName =>  method() = 'Bill'";
print bill.getName() == "Bill";
